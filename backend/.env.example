# Copy to .env and fill in real values. Never commit .env.
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=makatipid_db
DB_USER=root
DB_PASSWORD=change-me-locally

# Must be long + random in production. Dev default matches old Spring default.
JWT_SECRET=local-dev-only-do-not-use-in-prod
JWT_EXPIRATION_MS=86400000

# PayMongo test secret. Empty = payments report "not configured" (503).
PAYMONGO_SECRET_KEY=
