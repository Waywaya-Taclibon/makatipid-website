# Copy to .env and fill in real values. Never commit .env.
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=makatipid_db
DB_USER=root
DB_PASSWORD=change-me-locally
# Set to 'true' for managed hosts that require TLS (TiDB Cloud, PlanetScale).
# 'lax' also encrypts but skips certificate verification (only for machines
# whose CA store can't validate the chain, e.g. some Windows/AV setups).
DB_SSL=false

# Must be long + random in production. Dev default matches old Spring default.
JWT_SECRET=local-dev-only-do-not-use-in-prod
JWT_EXPIRATION_MS=86400000

# PayMongo test secret. Empty = payments report "not configured" (503).
PAYMONGO_SECRET_KEY=

# Cloudinary (property photos). Empty = photo uploads report "not configured".
# Get these from https://cloudinary.com > Dashboard > Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayMongo webhook signing secret (Dashboard > Webhooks). Empty = webhook reports 503.
PAYMONGO_WEBHOOK_SECRET=

# One-click demo (shared demo owner + renter accounts, seeded listings, mock
# payments). Set to false to hide every demo button AND refuse /api/auth/demo.
DEMO_LOGIN_ENABLED=true
# Optional override for the bundled demo photo URLs (comma-separated). Defaults
# to /demo-photos/demo-1.jpg … /demo-photos/demo-6.jpg, served from
# frontend/public/demo-photos. Leave empty to use the default set.
DEMO_PHOTOS=
