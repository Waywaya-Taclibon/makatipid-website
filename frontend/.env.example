# Copy to .env.local and paste your PayMongo TEST public key.
# Test mode only — no real money moves.
VITE_PAYMONGO_PUBLIC_KEY=pk_test_PASTE_YOUR_KEY_HERE
# Backend base URL (must end with /api). Local default works without this line.
# Production (Vercel env settings): https://<your-backend>.onrender.com/api
VITE_API_URL=http://localhost:8080/api
